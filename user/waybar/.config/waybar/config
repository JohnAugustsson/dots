{
  "output": "DP-2",
  "layer": "bottom",
  "position": "bottom",
  "reload_style_on_change": true,
  "modules-right": ["custom/player-prev", "mpris", "custom/player-next"],
  "modules-center": ["hyprland/workspaces"],
  "modules-left": [
    "custom/notification",
    "clock",
    "network",
    "custom/headscale",
    "wireplumber",
    "cpu",
    "memory",
    "temperature",
    "custom/gpu-stats",
    "bluetooth",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  "wireplumber": {
    "format": " {volume}%",
    "format-muted": " {volume}%",
    "tooltip-format": "{node_name}",
    "on-click": "~/.config/waybar/scripts/wiremix-popup.sh"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },

  "clock": {
    "format": "{:%m/%d/%A %H:%M:%S} ",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<b>{}</b>",
        "months": "<span><b>{}</b></span>",
        "weekdays": "<span>{}</span>"
      }
    }
  },

  "mpris": {
    "player": "playerctld",
    "format": "{player_icon} {artist} - {title}",
    "format-paused": "{status_icon} {player_icon} {artist} - {title}",
    "player-icons": {
      "default": "",
      "spotify": "",
      "brave": "",
      "firefox": "",
      "mpv": "󰐹",
      "vlc": "󰐹"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "tooltip": true,
    "min-length": 40,
    "max-length": 40,
    "justify": "left",
    "on-click": "playerctl -p playerctld play-pause",
    "on-click-middle": "playerctl -p playerctld previous",
    "on-click-right": "playerctl -p playerctld next",
    "on-scroll-up": "playerctld unshift",
    "on-scroll-down": "playerctld shift"
  },

  "custom/player-prev": {
    "format": "{}",
    "exec": "printf '‹'",
    "interval": "once",
    "tooltip": false,
    "on-click": "playerctld unshift"
  },

  "custom/player-next": {
    "format": "{}",
    "exec": "printf '›'",
    "interval": "once",
    "tooltip": false,
    "on-click": "playerctld shift"
  },

  "network": {
    "format": "󰈀",
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    "tooltip-format-disconnected": "Error",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} 󰈀",
    "on-click": "kitty nmtui"
  },

  "custom/headscale": {
    "exec": "~/.config/waybar/scripts/headscale-status.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/headscale-menu.sh"
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "BT-off",
    "format-disabled": "󰂲",
    "format-connected-battery": "{device_battery_percentage}% 󰂯",
    "format-alt": "{device_alias} 󰂯",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
    "on-click-right": "blueman-manager"
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "tooltip": false
  },

  "memory": {
    "format": " {used:0.1f}G/{total:0.1f}G",
    "tooltip": false
  },

  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "tooltip": false
  },

  "custom/gpu-stats": {
    "exec": "~/.config/waybar/scripts/gpu-stats.sh",
    "interval": 2,
    "format": "{}",
    "tooltip": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  }
}
